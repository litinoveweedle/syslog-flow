[Unit]
Description=syslog-flow web viewer
Documentation=https://github.com/inventor7777/syslog-flow
After=network-online.target rsyslog.service
Wants=network-online.target
Wants=rsyslog.service

[Service]
Type=simple
User=syslog-flow
Group=syslog-flow
ExecStart=/usr/local/bin/syslog-flow
Restart=on-failure
RestartSec=2
Environment=TZ=UTC
Environment=SYSLOG_FLOW_LOG_DIR=/var/log/syslog-flow
Environment=SYSLOG_FLOW_CONFIG_DIR=/var/lib/syslog-flow
Environment=SYSLOG_FLOW_RESOURCES_DIR=/usr/local/share/syslog-flow
Environment=SYSLOG_FLOW_ADDR=127.0.0.1
Environment=SYSLOG_FLOW_PORT=2200
UMask=0002
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/syslog-flow /etc/syslog-flow
PrivateTmp=true

[Install]
WantedBy=multi-user.target
